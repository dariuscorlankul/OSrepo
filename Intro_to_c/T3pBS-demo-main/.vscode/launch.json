{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) sayHello",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sayhello",
            "args": ["bert"],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "make sayHello"
        },
